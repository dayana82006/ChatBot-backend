# Configuración General
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-3.5-turbo

# Embeddings
USE_OPENAI_EMBEDDINGS=false
EMBED_MODEL=intfloat/multilingual-e5-small

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_kb

# RAG Configuration
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.7

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Base de Datos
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=chatbot_db
DB_PORT=3306

# WhatsApp (configurar en Meta for Developers)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# URL pública para webhooks (usar ngrok en desarrollo)
PUBLIC_BASE_URL=https://tu-dominio.ngrok.io

# Telegram (opcional - descomentar si se usa en lugar de WhatsApp)
# TELEGRAM_BOT_TOKEN=1234567890:AAxxxxx-tu-token-de-bot-de-telegram