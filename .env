
# Configuración General
OPENAI_API_KEY=tu_clave_de_openai # Opcional si no usas OpenAI
USE_OPENAI_EMBEDDINGS=false # Cambiar a true si usas OpenAI para embeddings
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=company_kb
EMBED_MODEL=intfloat/multilingual-e5-small
FRONTEND_ORIGIN=http://localhost:5173 # URL de tu frontend de React


WHATSAPP_VERIFY_TOKEN=mi_token_de_verificacion
WHATSAPP_TOKEN=token_bot_whatsapp
WHATSAPP_PHONE_ID=id_telefono_whatsapp

# Telegram (Descomentar y configurar si se elige Telegram)
# TELEGRAM_BOT_TOKEN=tu_token_de_bot_de_telegram
# PUBLIC_BASE_URL=https://tu_dominio.com/api # URL pública de tu API para webhooks de Telegram

# Base de datos para persistencia de chats (SQLite por defecto)
DATABASE_URL=sqlite:///./sql_app.db

DB_USER=user
DB_PASSWORD=password
DB_NAME=chatbot_db
DB_HOST=localhost
DB_PORT=3306
