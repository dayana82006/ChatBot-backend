# FastEmbed con modelo soportado
USE_OPENAI_EMBEDDINGS=false
EMBED_MODEL=BAAI/bge-small-en-v1.5


# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Configuración de sesión y cache
MAX_CHAT_TURNS=5
SESSION_EXPIRE=1800
CACHE_EXPIRE=300


# Gemini para el LLM
GEMINI_API_KEY=
USE_GEMINI=true
LLM_MODEL_NAME=gemini-2.5-flash

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_kb

# RAG Configuration
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.7

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Base de Datos
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=chatbot_db
DB_PORT=3306

# WhatsApp (configurar en Meta for Developers)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# URL pública para webhooks (usar ngrok en desarrollo)
PUBLIC_BASE_URL=

# Telegram (opcional - descomentar si se usa en lugar de WhatsApp)
# TELEGRAM_BOT_TOKEN=1234567890:AAxxxxx-tu-token-de-bot-de-telegram
# OpenAI (mantener vacío si no se usa)
OPENAI_API_KEY=